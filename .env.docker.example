# GitHub OAuth — set callback to match how you access the app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Session (long random string)
SESSION_SECRET=

# Encryption key for access tokens (32 bytes hex — run: openssl rand -hex 32)
ENCRYPTION_KEY=

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Production profile (docker compose --profile prod up):
# NODE_ENV=production
# FRONTEND_URL=
# GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
