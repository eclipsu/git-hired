# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Session
SESSION_SECRET=

# Encryption key for access tokens (32 bytes hex — run: openssl rand -hex 32)
ENCRYPTION_KEY=

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
